{
    "enhConfig": {
        "enhKey": "🕹️",
        "spawn": "do-invoke/do-invoke.js",
        "withAttrs": {
            "base": "🕹️",
            "_base": {
                "mapsTo": "invokeParamSet",
                "parser": "parse-pattern-statements",
                "instanceOf": "Array",
                "parserConfig": [
                    {
                        "name": "idWithMethodAndEvent",
                        "pattern": "^#(?<targetSpecifier.targetElementId>[^?]+)\\?\\.(?<targetSpecifier.hostOrPeerMethodName>\\w+) on (?<localEventType>\\w+)$",
                        "description": "Element ID with method and explicit event type: #{{id}}?.method on event",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "idWithMethod",
                        "pattern": "^#(?<targetSpecifier.targetElementId>[^?]+)\\?\\.(?<targetSpecifier.hostOrPeerMethodName>\\w+)$",
                        "description": "Element ID with method, default event: #{{id}}?.method",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "methodWithEvent",
                        "pattern": "^(?<targetSpecifier.hostOrPeerMethodName>\\w+) on (?<localEventType>\\w+)$",
                        "description": "Method name with explicit event type: method on event",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    },
                    {
                        "name": "methodOnly",
                        "pattern": "^(?<targetSpecifier.hostOrPeerMethodName>\\w+)$",
                        "description": "Method name only, default event: method",
                        "defaultVals": {
                            "localEventType": "click"
                        }
                    }
                ]
            },
            "rawStatements": "${base}"
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifAllOf": [
                    "invokeParamSet",
                    "enhancedElement"
                ]
            }
        }
    }
}
